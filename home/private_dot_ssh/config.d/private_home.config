Host verzamelaar
    Hostname 192.168.50.10
    Port 22
    User cbos
    ControlMaster auto
    ControlPath ~/.ssh/control/%C
    ControlPersist 10m

Host hapi
    Hostname hapi.fritz.box
    Port 22
    User hapi

Host vw1
    Hostname 192.168.60.10
    Port 22
    User core
    ControlMaster auto
    ControlPath ~/.ssh/control/%C
    ControlPersist 10m

Host git.casa.ceesbos.nl
    Port 8222
    User git
    IdentityFile ~/.ssh/id_rsa_ceesbos